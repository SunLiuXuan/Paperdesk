# Copy this file to .env and fill in your provider's values. Never share .env.
AI_API_KEY=
AI_MODEL=
# Include /v1 when required by your provider. Must support Chat Completions JSON mode.
AI_BASE_URL=https://api.openai.com/v1

# Optional: Semantic Scholar API key (separate from the AI provider key).
# Public requests may be rate-limited; no key is needed for Crossref.
SEMANTIC_SCHOLAR_API_KEY=

# Optional GitHub token for public repository Stars (separate from AI key).
GITHUB_TOKEN=
